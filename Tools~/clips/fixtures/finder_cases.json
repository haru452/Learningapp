[
  { "name": "zero duration line skipped", "word": "calm",
    "lines": [ { "start": 5.0, "duration": 0, "text": "calm" }, { "start": 8.0, "duration": 2.0, "text": "so calm" } ],
    "expect": [ { "startMs": 7000, "endMs": 10000, "sentence": "so calm" } ] },
  { "name": "plain word", "word": "calm",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "I feel calm." } ],
    "expect": [ { "startMs": 4000, "endMs": 7000, "sentence": "I feel calm." } ] },
  { "name": "longer word does not match", "word": "calm",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "calmness helps" } ],
    "expect": [] },
  { "name": "punctuation and capital", "word": "calm",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "Calm, please" } ],
    "expect": [ { "startMs": 4000, "endMs": 7000, "sentence": "Calm, please" } ] },
  { "name": "hyphen splits", "word": "calm",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "calm-looking" } ],
    "expect": [ { "startMs": 4000, "endMs": 7000, "sentence": "calm-looking" } ] },
  { "name": "apostrophe word", "word": "don't",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "I don't know" } ],
    "expect": [ { "startMs": 4000, "endMs": 7000, "sentence": "I don't know" } ] },
  { "name": "start near zero", "word": "calm",
    "lines": [ { "start": 0.4, "duration": 2.0, "text": "Stay calm now" } ],
    "expect": [ { "startMs": 0, "endMs": 2400, "sentence": "Stay calm now" } ] },
  { "name": "lead and end", "word": "calm",
    "lines": [ { "start": 12.5, "duration": 2.0, "text": "Be calm today" } ],
    "expect": [ { "startMs": 11500, "endMs": 14500, "sentence": "Be calm today" } ] },
  { "name": "three hits keep two", "word": "calm",
    "lines": [
      { "start": 10.0, "duration": 2.0, "text": "Calm one" },
      { "start": 20.0, "duration": 2.0, "text": "Calm two" },
      { "start": 30.0, "duration": 2.0, "text": "Calm three" } ],
    "expect": [
      { "startMs": 9000, "endMs": 12000, "sentence": "Calm one" },
      { "startMs": 19000, "endMs": 22000, "sentence": "Calm two" } ] },
  { "name": "multi word", "word": "look after",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "Please look after it" } ],
    "expect": [ { "startMs": 4000, "endMs": 7000, "sentence": "Please look after it" } ] },
  { "name": "multi word not consecutive", "word": "look after",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "look at it after" } ],
    "expect": [] },
  { "name": "newline becomes space", "word": "calm",
    "lines": [ { "start": 5.0, "duration": 2.0, "text": "Stay\ncalm\nplease\n" } ],
    "expect": [ { "startMs": 4000, "endMs": 7000, "sentence": "Stay calm please" } ] }
]
